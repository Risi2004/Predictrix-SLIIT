# Copy to project/.env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Qwen3.8 27B (the model named in the proposal). Free, rate-limited version: qwen/qwen3.8-27b:free
SERA_MODEL=qwen/qwen3.8-27b
SERA_MODEL_SMALL=
# PostgreSQL (optional). Leave empty to use the local SQLite file outputs/sera.db
DATABASE_URL=
# 1 = run every agent on its rule-based fallback (no API calls)
SERA_NO_LLM=0
SERA_LLM_TIMEOUT=25
SERA_LLM_RETRIES=2
SERA_STEP_DELAY=0.7
SERA_TICK_SECONDS=1.3
# 1 = clock shows your PC's real time and runs at normal speed (default 0 = fast night-shift demo starting 02:10)
SERA_REAL_CLOCK=0
# 0 = no automatic hospital requests; only requests you send from the Hospital ward screen
SERA_AUTO_FEED=1
